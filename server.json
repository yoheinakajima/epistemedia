        "type": "stdio"
      },
      "runtimeHint": "uvx",
      "runtimeArguments": ["epistemedia"],
      "packageArguments": ["mcp", "serve"]
    }
  ],
  "repository": {
    "url": "https://github.com/yoheinakajima/epistemedia",
    "source": "github"
  }
}
